{
    "database": {
        "type": "cassandra",
        "cassandra": { "contact_points": "127.0.0.1", "port": 9042, "keyspace": "clio" }
    },
    "etl_sources": [{ "ip": "127.0.0.1", "ws_port": "6006", "grpc_port": "50051" }],
    "server": { "ip": "0.0.0.0", "port": 51233, "__ng_web_server": true },
    "dos_guard": {
        "max_fetches": 1000000, "max_connections": 1000,
        "max_requests": 1000000, "sweep_interval": 10,
        "__ng_default_weight": 1,
        "__ng_weights": [ { "method": "account_info", "weight": 5 } ]
    },
    "log": { "level": "info", "enable_console": true },
    "allow_no_etl": true,
    "io_threads": 4,
    "workers": 4
}
